# Copy to docker/.env and adjust. Used by docker-compose.yml.
#
# No personal path is versioned anywhere: PROJECT_DIR is the mount point
# INSIDE the container, and the host's own checkout is bind-mounted onto it
# by compose using a relative path.

IMAGE=poesia-emu:22.04

# Where the repository lands inside the container.
PROJECT_DIR=/workspace/multichain

# Host directory for run output, bind-mounted at /results and exported as
# EXPERIMENT_ROOT. A twenty-node run produces hundreds of megabytes, so
# keeping it off the repository volume is usually right. Relative to docker/.
RESULTS_DIR=../experiments/results

# Soft/hard limit for open files. Twenty daemons with their peers need more
# than the default.
NOFILE=1048576

# ---------------------------------------------------------------------------
# Resources. All three are DELIBERATELY EMPTY/ZERO, which is how docker says
# "no limit": an experiment started without asking for anything gets every CPU
# and all the memory the machine has. A run whose daemons are throttled
# measures the throttle rather than the protocol, so only set these when you
# deliberately want less than the whole machine.
# ---------------------------------------------------------------------------

# Physical-core-only CPU list, from `./docker/mcsim cpus`. Empty = every CPU.
# Pinning to hyper-thread siblings costs throughput and makes block times look
# like protocol behaviour when they are scheduling.
CPUSET=

# Fractional CPU quota, e.g. 8 or 4.5. 0 = no quota.
CPUS=0

# Memory ceiling, e.g. 16g. 0 = no ceiling.
MEMORY=0
