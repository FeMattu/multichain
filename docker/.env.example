# cp .env.example .env, then set USER_UID/USER_GID to your own ids
# (id -u / id -g) so files written into the mounted repository stay yours.
USER_NAME=mattu
USER_UID=1000
USER_GID=1000

# Mount point inside the container. Keep this default: the recorded
# shadow.yaml / processed-config.yaml files embed absolute paths.
PROJECT_DIR=/home/mattu/multichain

# Shadow pinned to the commit that produced the stored campaigns
# (shadow --version -> v3.3.0-205-g93d3c32cc).
SHADOW_REF=93d3c32cc
RUST_VERSION=1.98.0

IMAGE=poesia-sim:22.04
SHM_SIZE=1024gb
NOFILE=1048576
