#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# mcsim — host-side wrapper around `docker run` for the POESIA / wPoA
# emulation container.
#
# Its reason to exist is the flag set. The container has to build MultiChain
# against an Ubuntu 22.04 userspace AND create network namespaces, veth pairs
# and qdiscs inside itself; getting one flag wrong fails several steps into a
# run with a message about `ip netns` rather than about the flag that was
# missing.
#
#   ./docker/mcsim build [--no-cache]
#   ./docker/mcsim shell [resource flags]
#   ./docker/mcsim run  <command...>
#   ./docker/mcsim exp  experiments/configs/experiments/<name>.yaml
#   ./docker/mcsim preflight
#   ./docker/mcsim cpus                 physical-core-only CPU list for --cpuset
#
# Resources. With no resource flag the container is UNCONSTRAINED: every CPU
# and all the memory the host has. That is the default on purpose — a run whose
# nodes are throttled measures the throttle, not the protocol. The flags below
# exist for the case where you deliberately want less:
#
#   --cpus=N            fractional CPU quota      (default: no quota)
#   --cpuset=LIST       pin to these CPUs         (default: every CPU)
#   --memory=SIZE       memory ceiling, e.g. 16g  (default: no ceiling)
#
# Environment overrides:
#   IMAGE=poesia-emu:22.04     image tag
#   PROJECT_DIR                mount point inside the container
#                              (default /workspace/multichain)
#   NOFILE=1048576             --ulimit nofile
#   RESULTS_DIR                host directory for run output; bind-mounted at
#                              /results and exported as EXPERIMENT_ROOT
# ---------------------------------------------------------------------------
set -Eeuo pipefail
trap 'printf "\033[31m[mcsim] failed at line %s\033[0m\n" "$LINENO" >&2' ERR

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"

IMAGE="${IMAGE:-poesia-emu:22.04}"
# No personal path: the default is a neutral mount point, and the host's own
# checkout is bind-mounted onto it.
PROJECT_DIR="${PROJECT_DIR:-/workspace/multichain}"
NOFILE="${NOFILE:-1048576}"
RESULTS_DIR="${RESULTS_DIR:-}"
CPUSET=""
CPUS=""
MEMORY=""

say()  { printf '\033[1m[mcsim]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[mcsim] %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31m[mcsim] %s\033[0m\n' "$*" >&2; exit 1; }

command -v docker >/dev/null || die "docker not found on PATH"

docker_flags() {
    local flags=()

    # CAP_NET_ADMIN: veth pairs, addresses, routes and qdiscs.
    flags+=(--cap-add NET_ADMIN)

    # CAP_SYS_ADMIN: `ip netns add` is not only a network operation. It creates
    # /run/netns, turns it into a shared bind mount and calls unshare(CLONE_NEWNET) —
    # all three are mount/namespace operations that CAP_NET_ADMIN does not cover.
    # Without this the run dies at "mount --make-shared /run/netns failed".
    flags+=(--cap-add SYS_ADMIN)

    # Docker's default AppArmor profile denies mount() outright, whatever the
    # capabilities say, so CAP_SYS_ADMIN alone still fails — with "Permission
    # denied" rather than "Operation not permitted", which is the only clue.
    # Still not --privileged: the device cgroup and the rest stay in force.
    flags+=(--security-opt apparmor=unconfined)

    # `ip netns` writes its handles under /var/run/netns, which must be
    # writable and must allow mounts.
    flags+=(--tmpfs /run:rw,exec,nosuid,size=64m)

    # Its own network namespace, so twenty emulated nodes cannot reach the
    # host's real network. `--network none` would remove lo, which the
    # management bridge needs, so a private bridge is the right answer.
    flags+=(--network bridge)

    # Twenty daemons with their peers exhaust the default soft limit.
    flags+=(--ulimit "nofile=${NOFILE}:${NOFILE}")

    # The repository, read-write: the harness writes results and the build
    # writes into src/.
    flags+=(-v "${REPO}:${PROJECT_DIR}")
    flags+=(-w "${PROJECT_DIR}")
    flags+=(-e "MULTICHAIN_HOME=${PROJECT_DIR}")

    # Run output can be very large; keeping it off the repository volume is
    # usually what you want.
    if [ -n "$RESULTS_DIR" ]; then
        mkdir -p "$RESULTS_DIR"
        flags+=(-v "${RESULTS_DIR}:/results")
        flags+=(-e "EXPERIMENT_ROOT=/results")
    fi

    # Resources. Nothing is passed unless it was asked for: an absent --cpus,
    # --cpuset-cpus and --memory is how docker expresses "all of it", and that
    # is the intended default for an emulation run.
    [ -n "$CPUSET" ] && flags+=(--cpuset-cpus "$CPUSET")
    [ -n "$CPUS" ]   && flags+=(--cpus "$CPUS")
    [ -n "$MEMORY" ] && flags+=(--memory "$MEMORY")

    [ -t 0 ] && flags+=(-it)

    printf '%s\n' "${flags[@]}"
}

need_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 || \
        die "image $IMAGE is not built. Run: ./docker/mcsim build"
}

# What the container was actually given, said out loud: an accidentally
# throttled run is otherwise indistinguishable from a slow protocol.
report_resources() {
    local cpus mem
    cpus="$(nproc 2>/dev/null || echo '?')"
    mem="$(awk '/MemTotal/ {printf "%.0f", $2 / 1048576}' /proc/meminfo 2>/dev/null || echo '?')"
    if [ -z "$CPUSET$CPUS$MEMORY" ]; then
        say "resources: unconstrained — all ${cpus} host CPUs, all ${mem} GiB"
    else
        say "resources: cpus=${CPUS:-all} cpuset=${CPUSET:-all} memory=${MEMORY:-all}" \
            "(host has ${cpus} CPUs, ${mem} GiB)"
    fi
}

run_in_container() {
    need_image
    report_resources
    local flags=(); mapfile -t flags < <(docker_flags)
    docker run --rm "${flags[@]}" "$IMAGE" "$@"
}

cmd_build() {
    local args=(build -t "$IMAGE" -f "$HERE/Dockerfile"
                --build-arg "PROJECT_DIR=${PROJECT_DIR}")
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-cache) args+=(--no-cache); shift ;;
            *) die "build: unknown argument $1" ;;
        esac
    done
    args+=("$HERE")
    say "building $IMAGE"
    docker "${args[@]}"
    say "done. Next: ./docker/mcsim run mc-build     (compiles MultiChain)"
}

cmd_shell()     { run_in_container bash; }
cmd_run()       { [ "$#" -gt 0 ] || die "run: nothing to run"; run_in_container "$@"; }
cmd_preflight() { MC_PREFLIGHT=0 run_in_container mc-preflight --strict; }

cmd_exp() {
    [ "$#" -ge 1 ] || die "exp: expected an experiment descriptor path"
    local descriptor="$1"; shift
    [ -f "$REPO/$descriptor" ] || [ -f "$descriptor" ] || \
        die "exp: no such descriptor: $descriptor"
    run_in_container experiments/scripts/run_experiment.sh \
        --experiment "$descriptor" "$@"
}

# Physical cores only: with hyper-threading, pinning to sibling threads costs
# a large fraction of the throughput and makes block times look like protocol
# behaviour when they are scheduling.
cmd_cpus() {
    awk -F: '/^processor/{p=$2} /^core id/{c=$2} /^physical id/{s=$2;
        key=s"-"c; if (!(key in seen)) {seen[key]=1; printf "%s%s", (n++?",":""), p+0}}
        END{print ""}' /proc/cpuinfo
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

COMMAND="${1:-}"; shift || true

# The resource flags are mcsim's own and must not reach the container's command
# line. Filtering rebuilds the argument list rather than blanking elements in
# place: a blanked element stays as an empty argument and `docker run` then
# tries to execute it.
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --cpuset=*) CPUSET="${arg#*=}" ;;
        --cpus=*)   CPUS="${arg#*=}" ;;
        --memory=*) MEMORY="${arg#*=}" ;;
        *)          ARGS+=("$arg") ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$COMMAND" in
    build)     cmd_build "$@" ;;
    shell)     cmd_shell ;;
    run)       cmd_run "$@" ;;
    exp)       cmd_exp "$@" ;;
    preflight) cmd_preflight ;;
    cpus)      cmd_cpus ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command: $COMMAND (try --help)" ;;
esac
