# ---------------------------------------------------------------------------
# Override di params.dat comuni ai quattro livelli.
# Sono valori di CATENA: finiscono in params.dat, sono hash-enforced e vengono
# ereditati da ogni nodo che si unisce alla rete (protocollo 20014).
# Riferimento: src/wpoa/docs/protocol-parameters.md
# ---------------------------------------------------------------------------

# --- spazio degli indirizzi PINNATO -----------------------------------------
# Normalmente casuale per catena. Fissarlo rende l'indirizzo di treasury
# riusabile su tutti i livelli (vedi tools/gen_treasury.sh).
ADDRESS_PUBKEYHASH_VERSION=00cca233
ADDRESS_SCRIPTHASH_VERSION=05202c86
PRIVATE_KEY_VERSION=80840860
ADDRESS_CHECKSUM_VALUE=303257e8

# --- consenso wPoA ----------------------------------------------------------
WPOA_SORTITION_DELTA=0.5      # Delta_max = delta * target-block-time
WPOA_SORTITION_LAMBDA=0.2     # guadagno della retroazione globale Phi
WPOA_RANDAO_LOOKBACK=1        # k nel seed H(R_tot[n-k] || h[n] || n+1)
WPOA_DUMPFUNCTION=sqrt        # smorzamento anti-balena: none | sqrt | log
ENABLE_WPOA_MALUS=1           # inerte (Psi=1) senza violazioni provate

# --- weight engine ----------------------------------------------------------
WEIGHT_EPOCH_LENGTH=12        # epoca in blocchi
WEIGHT_KAPPA=100              # c_i = ESG_i * tau_i / kappa
WEIGHT_ALPHA=0.2              # A_k = alpha * Theta * W_k / W_tot
WEIGHT_LAMBDA=0.5             # w_k = W_k * [rho_{k,e-1}*lambda + (1-lambda)]

# --- catena -----------------------------------------------------------------
TARGET_BLOCK_TIME=15          # default; sovrascrivibile con run.sh tbt=<n>
SETUP_FIRST_BLOCKS=60         # > epoca(12) + margine di stabilita'(6) = 18
MINE_EMPTY_ROUNDS=1000        # blocchi anche senza traffico: serve al campionamento
# Lo Spacing nativo vale ceil(d*(N-1)) blocchi fra due blocchi dello stesso
# firmatario. La tesi (5.12.3) prevede che sotto wPoA sia rimosso, ma la misura
# mostra che resta vincolante: con d=0.3 e N=4 (admin + 3 miner) lo spacing vale
# 1, nessun miner puo' firmare due blocchi di fila e la distribuzione osservata
# collassa su un round robin qualunque siano i pesi (0 blocchi consecutivi su 190
# misurati, contro ~99 attesi). d=0 lo rende inerte per costruzione e lascia
# misurare la sola selezione pesata. Alzarlo di nuovo e' il modo per misurare
# quanto lo spacing residuo interferisca con la wPoA.
MINING_DIVERSITY=0

# --- economia del GAS (cap. 4.2.1 / 4.3.1 della tesi) -----------------------
NATIVE_CURRENCY_MULTIPLE=100000000    # 1 GAS = 1e8 unita' raw
FIRST_BLOCK_REWARD=100000000000000    # premine: 1e6 GAS all'admin (Apuana SB)
INITIAL_BLOCK_REWARD=0                # nessun conio dopo la genesi
MINIMUM_RELAY_FEE=20000000            # 0.2 GAS per 1000 byte ~= 0.2 GAS/tx
