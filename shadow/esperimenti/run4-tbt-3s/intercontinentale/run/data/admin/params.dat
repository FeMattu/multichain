genesis-nonce = 216                     # Genesis block nonce.
genesis-pubkey-hash = c36c8de86abf671b6a613351c70d26b55296eab3 # Genesis block coinbase output public key hash.
genesis-hash = 009ffa51b0577c3ecf0d204c8e0aa3447f488bfd6cde92c1a92f0a595a9c2091 # Genesis block hash.
