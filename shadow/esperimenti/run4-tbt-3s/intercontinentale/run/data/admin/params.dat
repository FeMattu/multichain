default-network-port = 6493             # Default TCP/IP port for peer-to-peer connection with other nodes.
default-rpc-port = 6492                 # Default TCP/IP port for incoming JSON-RPC API requests.
chain-name = poesiaintercontinentale    # Chain name, used as first argument for multichaind and multichain-cli.
protocol-version = 20014                # Protocol version at the moment of blockchain genesis.
network-message-start = f3e4caed        # Magic value sent as the first 4 bytes of every peer-to-peer message.
address-pubkeyhash-version = 00cca233   # Version bytes used for pay-to-pubkeyhash addresses.
address-scripthash-version = 05202c86   # Version bytes used for pay-to-scripthash addresses.
private-key-version = 80840860          # Version bytes used for exporting private keys.
address-checksum-value = 303257e8       # Bytes used for XOR in address checksum calculation.

