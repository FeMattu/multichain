# ---------------------------------------------------------------------------
# Real network emulation harness (experiments/)
# ---------------------------------------------------------------------------
# Run output. A twenty-node run produces hundreds of megabytes of debug.log
# alone, so nothing under results/ is versioned except its README and the
# .gitkeep. EXPERIMENT_ROOT moves the whole tree off this volume.
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/README.md

# Topology exports: every file here is reproducible from the YAML.
experiments/topology/generated/*
!experiments/topology/generated/.gitkeep

# The treasury private key, when someone regenerates a full pair with
# `cli multichain treasury --with-key`. The versioned treasury.json carries
# the ADDRESS only: the admin imports it watch-only and nothing in the harness
# ever spends from it, so the key has no runtime purpose. See
# experiments/docs/migration-from-shadow.md.
experiments/configs/treasury.key.json
experiments/configs/*.key.json

# Python bytecode and test caches under the harness.
experiments/**/__pycache__/
experiments/.pytest_cache/
experiments/**/*.pyc

# The autotools rule `conftest.*` further up is meant for configure's probe
# files; it also swallows pytest's conftest.py, which is real source here.
!experiments/conftest.py
!experiments/tests/conftest.py

# The legacy Shadow tree. Its tracked content was migrated or archived in git
# history at 6278274; what may still sit here on a developer's machine is the
# ~3 GB of raw run output that was never tracked. Ignored so it cannot be
# committed back by accident.
shadow/
